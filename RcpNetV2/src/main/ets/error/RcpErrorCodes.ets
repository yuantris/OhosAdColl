/** 请求取消类错误码: 标准化为 CANCEL 类(与调用方 abort 同语义), 不参与重试 */
const RCP_CANCEL_CODES: number[] = [
  1007900992,  // 请求已被取消
  1007910003,  // 请求被取消(URPC)
  1007900042   // 操作被应用程序回调中止(curl ABORTED_BY_CALLBACK)
];

/** 设备环境类错误码: 蜂窝不可用/会话关闭/存储IO/内存不足/连接数上限等设备侧问题, 短时重试无意义 */
const RCP_ENVIRONMENT_CODES: number[] = [
  1007900986,  // 建立蜂窝链接超时(飞行模式/SIM 未激活)
  1007900993,  // 会话已关闭
  1007900994,  // 会话数达到限制
  1007900990,  // 内存不足(RCP)
  1007900027,  // 内存不足(curl)
  1007900023,  // 写入接收数据到磁盘失败
  1007900985,  // 文件系统IO错误
  1007900988,  // 文件打开错误
  1007900987,  // 创建目录失败
  1007900037,  // 无法读取文件
  1007900026,  // 读取本地数据失败
  1007900063,  // 超出最大文件大小
  1007900089   // 已达到最大连接数限制
];

/** 请求配置类错误码: URL格式/协议/明文限制/参数/代理类型等调用方配置错误, 重试必然复现 */
const RCP_CONFIG_CODES: number[] = [
  1007900001,  // 不支持的协议
  1007900003,  // URL格式错误
  1007900049,  // 请求选项格式不正确
  1007900201,  // 禁止明文传输
  1007900401,  // 接口参数错误
  1007900995,  // 获取系统代理失败
  1007900996,  // 代理类型不支持
  1007900997,  // 无效的内容类型
  1007900998,  // 所请求的方法不被支持
  1007900100   // 数据长度超过允许的范围
];

/**
 * 查询错误码的官方中文描述
 * @param code RCP 错误码
 * @returns 中文描述; 非官方错误码返回 undefined
 */
export function getRcpErrorMessage(code: number): string | undefined {
  return RCP_ERROR_MESSAGES.get(code);
}

/**
 * 判断错误码是否为请求取消类
 * @param code RCP 错误码
 * @returns true 表示取消类
 */
export function isCancelRcpCode(code: number): boolean {
  return RCP_CANCEL_CODES.indexOf(code) >= 0;
}

/**
 * 判断错误码是否为设备环境类(重试无意义)
 * @param code RCP 错误码
 * @returns true 表示设备环境类
 */
export function isEnvironmentRcpCode(code: number): boolean {
  return RCP_ENVIRONMENT_CODES.indexOf(code) >= 0;
}

/**
 * 判断错误码是否为请求配置类(重试必然复现)
 * @param code RCP 错误码
 * @returns true 表示配置类
 */
export function isConfigRcpCode(code: number): boolean {
  return RCP_CONFIG_CODES.indexOf(code) >= 0;
}

/**
 * 判断 network 类错误码是否不可重试(设备环境类 + 请求配置类)
 * @param code RCP 错误码
 * @returns true 表示该错误不应重试
 */
export function isNonRetryableRcpCode(code: number): boolean {
  return isEnvironmentRcpCode(code) || isConfigRcpCode(code);
}
